# Exemple .env pour développement
# Copiez ceci en ".env" et ajustez. NE PAS committer vos secrets.

# Base de données
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_NAME=clinikauto

# Comportement admin en cas d'indisponibilité DB (0=fallback JSON en local)
CATALOG_ADMIN_REQUIRE_DB=0

# SMTP
SMTP_USERNAME=smtp@clinikauto.fr
SMTP_PASSWORD=
SMTP_HOST=mail.clinikauto.fr
SMTP_PORT=465
SMTP_SECURE=ssl

# Google API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Admin
ADMIN_PASSWORD_HASH=
ADMIN_HIDDEN_ENTRY_KEY=
ADMIN_PASSWORD_RESET_EMAIL=admin@clinikauto.fr

# Autres
EMAIL_EXPEDITEUR=clinikauto74@gmail.com
