# o2switch pagespeed start / DO NOT REMOVE OR EDIT
<IfModule pagespeed_module>
ModPagespeed on
ModPagespeedRewriteLevel PassThrough
ModPagespeedEnableFilters add_head,canonicalize_javascript_libraries,collapse_whitespace,combine_css,extend_cache,hint_preload_subresources,lazyload_images,rewrite_javascript,move_css_above_scripts,move_css_to_head,insert_dns_prefetch,remove_comments,remove_quotes,rewrite_images,strip_image_meta_data,sprite_images
</IfModule>
# o2switch pagespeed end / DO NOT REMOVE OR EDIT
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# =========================================================
# Configuration o2switch (Apache + PHP-FPM / CloudLinux)
# Les limites PHP sont dans .user.ini (pas php_value ici)
# =========================================================

Options -Indexes

# Activation HTTPS - décommenter après installation SSL sur o2switch :
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Sécurité : bloquer l'accès direct aux fichiers sensibles
<FilesMatch "\.(json|log|sql|md|ini)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(config|composer)\.php$">
    Require all denied
</FilesMatch>

# Durcissement prod: bloquer l'assistant OAuth Google une fois le token obtenu
 <Files "google-oauth-setup.php">
     Require all denied
 </Files>

# Bloque les fichiers caches, utilitaires dev et sauvegardes.
<FilesMatch "(^\.|\.bak$|\.new$|\.ps1$|\.bat$|\.exe$|^tmp_.*\.php$|^test_.*\.php$|^diag_.*\.php$|^diag_.*\.ps1$|^email-log\.php$|^extracted_section\.txt$)">
    Require all denied
</FilesMatch>
