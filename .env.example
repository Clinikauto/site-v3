# Clinik Auto - exemple de variables d'environnement
# Copier ce fichier vers .env et remplacer les valeurs.

# Base de donnees
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=change_me
DB_NAME=clinikauto

# 0 = fallback JSON autorise si DB indisponible (pratique en local)
# 1 = mode strict DB (recommande en production)
CATALOG_ADMIN_REQUIRE_DB=1

# SMTP
SMTP_PASSWORD=change_me

# Google Calendar OAuth
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_REFRESH_TOKEN=change_me

# Admin
ADMIN_PASSWORD_HASH=change_me
ADMIN_HIDDEN_ENTRY_KEY=change_me
